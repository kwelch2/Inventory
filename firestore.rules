rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed model: catalog/settings/vendors/pricing are public reference data
    // with verified @gemfireems.org admin CRUD. Inventory and requests support
    // validated public writes for the intentionally zero-login staff pages.
    // User profiles are owner-only. Orders are currently read-only for admins.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.matches('^[^@]+@gemfireems[.]org$');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalNullableString(data, field, maxLength) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalNumber(data, field, minimum, maximum) {
      return !(field in data) ||
        (data[field] is number && data[field] >= minimum && data[field] <= maximum);
    }

    function optionalLegacyNumber(data, field, minimum, maximum) {
      return !(field in data) ||
        (data[field] is number && data[field] >= minimum && data[field] <= maximum) ||
        (data[field] is string && data[field].size() <= 20);
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function optionalLegacyDate(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp ||
        (data[field] is string && data[field].size() <= 40) || data[field] is map;
    }

    function stringList(values, maxSize, maxItemLength) {
      return values is list && values.size() <= maxSize &&
        (values.size() < 1 || (values[0] is string && values[0].size() <= maxItemLength)) &&
        (values.size() < 2 || (values[1] is string && values[1].size() <= maxItemLength)) &&
        (values.size() < 3 || (values[2] is string && values[2].size() <= maxItemLength)) &&
        (values.size() < 4 || (values[3] is string && values[3].size() <= maxItemLength)) &&
        (values.size() < 5 || (values[4] is string && values[4].size() <= maxItemLength)) &&
        (values.size() < 6 || (values[5] is string && values[5].size() <= maxItemLength)) &&
        (values.size() < 7 || (values[6] is string && values[6].size() <= maxItemLength)) &&
        (values.size() < 8 || (values[7] is string && values[7].size() <= maxItemLength)) &&
        (values.size() < 9 || (values[8] is string && values[8].size() <= maxItemLength)) &&
        (values.size() < 10 || (values[9] is string && values[9].size() <= maxItemLength));
    }

    function optionalStringList(data, field, maxSize, maxItemLength) {
      return !(field in data) || stringList(data[field], maxSize, maxItemLength);
    }

    function validItemReference(ref) {
      return ref is map && ref.keys().hasOnly([
          'ref', 'vendorId', 'vendorName', 'description', 'isCurrent', 'addedAt'
        ]) && ref.keys().hasAll(['ref', 'isCurrent']) &&
        ref.ref is string && ref.ref.size() > 0 && ref.ref.size() <= 100 &&
        ref.isCurrent is bool && optionalString(ref, 'vendorId', 100) &&
        optionalString(ref, 'vendorName', 200) && optionalString(ref, 'description', 500) &&
        optionalLegacyDate(ref, 'addedAt');
    }

    function itemReferenceList(values) {
      return values is list && values.size() <= 10 &&
        (values.size() < 1 || validItemReference(values[0])) &&
        (values.size() < 2 || validItemReference(values[1])) &&
        (values.size() < 3 || validItemReference(values[2])) &&
        (values.size() < 4 || validItemReference(values[3])) &&
        (values.size() < 5 || validItemReference(values[4])) &&
        (values.size() < 6 || validItemReference(values[5])) &&
        (values.size() < 7 || validItemReference(values[6])) &&
        (values.size() < 8 || validItemReference(values[7])) &&
        (values.size() < 9 || validItemReference(values[8])) &&
        (values.size() < 10 || validItemReference(values[9]));
    }

    function isValidCatalog(data) {
      return data.keys().hasOnly([
          'catalogId', 'itemName', 'itemRef', 'itemRefArray', 'itemReferences',
          'itemNameAlt', 'altNames', 'barcode', 'barcodes', 'preferredVendorId',
          'category', 'unit', 'uoi', 'packSize', 'parLevel', 'minPar', 'isActive',
          'active', 'notes', 'id', 'createdAt', 'updatedAt'
        ]) && data.keys().hasAll(['itemName']) &&
        data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 200 &&
        optionalString(data, 'catalogId', 100) && optionalString(data, 'itemRef', 100) &&
        optionalStringList(data, 'itemRefArray', 10, 100) &&
        (!('itemReferences' in data) || itemReferenceList(data.itemReferences)) &&
        optionalStringList(data, 'itemNameAlt', 10, 200) && optionalStringList(data, 'altNames', 10, 200) &&
        optionalStringList(data, 'barcode', 10, 100) && optionalStringList(data, 'barcodes', 10, 100) &&
        optionalString(data, 'preferredVendorId', 100) && optionalString(data, 'category', 100) &&
        optionalString(data, 'unit', 50) && optionalString(data, 'uoi', 50) &&
        optionalNumber(data, 'packSize', 0, 1000000) && optionalNumber(data, 'parLevel', 0, 1000000) &&
        optionalNumber(data, 'minPar', 0, 1000000) && optionalBool(data, 'isActive') &&
        optionalBool(data, 'active') && optionalString(data, 'notes', 2000) &&
        optionalString(data, 'id', 100) && optionalTimestamp(data, 'createdAt') &&
        optionalLegacyDate(data, 'updatedAt');
    }

    function isValidNamedSetting(data) {
      return data.keys().hasOnly(['name', 'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['name']) && data.name is string &&
        data.name.size() > 0 && data.name.size() <= 200 &&
        optionalTimestamp(data, 'createdAt') && optionalTimestamp(data, 'updatedAt');
    }

    function isValidUnit(data) {
      return data.keys().hasOnly([
          'name', 'active', 'type', 'location', 'defaultParOverrides', 'createdAt', 'updatedAt'
        ]) && data.keys().hasAll(['name']) && data.name is string &&
        data.name.size() > 0 && data.name.size() <= 200 && optionalBool(data, 'active') &&
        optionalString(data, 'type', 100) && optionalString(data, 'location', 300) &&
        (!('defaultParOverrides' in data) ||
          (data.defaultParOverrides is map && data.defaultParOverrides.size() <= 200)) &&
        optionalTimestamp(data, 'createdAt') && optionalTimestamp(data, 'updatedAt');
    }

    function isValidVendor(data) {
      return data.keys().hasOnly([
          'name', 'phone', 'email', 'webUrl', 'weburl', 'orderUrl', 'accountNumber',
          'serviceFee', 'notes', 'contactName', 'contactPhone', 'contactEmail',
          'address', 'preferred', 'createdAt', 'updatedAt', '﻿vendorId'
        ]) && data.keys().hasAll(['name']) && data.name is string &&
        data.name.size() > 0 && data.name.size() <= 200 &&
        optionalLegacyNumber(data, 'phone', 0, 999999999999999) && optionalString(data, 'email', 254) &&
        optionalString(data, 'webUrl', 2048) && optionalString(data, 'weburl', 2048) &&
        optionalString(data, 'orderUrl', 2048) && optionalString(data, 'accountNumber', 200) &&
        optionalNumber(data, 'serviceFee', 0, 1000000) && optionalString(data, 'notes', 5000) &&
        optionalString(data, 'contactName', 200) && optionalString(data, 'contactPhone', 100) &&
        optionalString(data, 'contactEmail', 254) && optionalString(data, 'address', 1000) &&
        optionalBool(data, 'preferred') && optionalString(data, '﻿vendorId', 100) &&
        optionalTimestamp(data, 'createdAt') && optionalTimestamp(data, 'updatedAt');
    }

    function isValidVendorPricing(data) {
      return data.keys().hasOnly([
          'pricingId', '﻿pricingId', 'catalogId', 'itemId', 'vendorId', 'unitPrice',
          'packSize', 'uoi', 'preferred', 'vendorItemNo', 'vendorItemNo2',
          'vendorOrderNumber', 'vendorBarcode', 'vendorStatus', 'lastChecked', 'notes',
          'createdAt', 'updatedAt'
        ]) && data.keys().hasAll(['catalogId', 'vendorId']) &&
        data.catalogId is string && data.catalogId.size() > 0 && data.catalogId.size() <= 100 &&
        data.vendorId is string && data.vendorId.size() > 0 && data.vendorId.size() <= 100 &&
        optionalString(data, 'pricingId', 100) && optionalString(data, '﻿pricingId', 100) &&
        optionalString(data, 'itemId', 100) && optionalLegacyNumber(data, 'unitPrice', 0, 100000000) &&
        optionalLegacyNumber(data, 'packSize', 0, 1000000) && optionalString(data, 'uoi', 50) &&
        (!('preferred' in data) || data.preferred is bool ||
          (data.preferred is string && data.preferred.size() <= 5)) &&
        optionalString(data, 'vendorItemNo', 200) && optionalString(data, 'vendorItemNo2', 200) &&
        optionalString(data, 'vendorOrderNumber', 200) && optionalString(data, 'vendorBarcode', 200) &&
        optionalString(data, 'vendorStatus', 50) && optionalString(data, 'lastChecked', 40) &&
        optionalString(data, 'notes', 2000) && optionalTimestamp(data, 'createdAt') &&
        optionalTimestamp(data, 'updatedAt');
    }

    function validRequestQuantity(data) {
      return ('quantity' in data &&
          ((data.quantity is number && data.quantity >= 0 && data.quantity <= 100000) ||
           (data.quantity is string && data.quantity.size() <= 20))) ||
        ('qty' in data &&
          ((data.qty is number && data.qty >= 0 && data.qty <= 100000) ||
           (data.qty is string && data.qty.size() <= 20)));
    }

    function isValidRequest(data) {
      return data.keys().hasOnly([
          'catalogId', 'itemId', 'otherItemName', 'quantity', 'qty', 'unit', 'unitId',
          'status', 'vendorId', 'vendorOverride', 'overrideVendorId', 'notes',
          'receivedAt', 'createdAt', 'updatedAt', 'lastOrdered', 'requesterEmail',
          'fulfilledByOrderLineId', 'neededByDate', '﻿requestId', 'batchedIntoOrderId',
          'reason', 'createdBy'
        ]) && data.keys().hasAll(['status', 'createdAt']) &&
        (('catalogId' in data && data.catalogId != null) ||
          ('itemId' in data && data.itemId.size() > 0) ||
          ('otherItemName' in data && data.otherItemName.size() > 0)) &&
        optionalLegacyNumber(data, 'quantity', 0, 100000) &&
        optionalLegacyNumber(data, 'qty', 0, 100000) && data.status is string &&
        data.status in ['Open', 'Ordered', 'Backordered', 'Back ordered', 'Received', 'Cancelled'] &&
        optionalNullableString(data, 'catalogId', 100) && optionalString(data, 'itemId', 100) &&
        optionalString(data, 'otherItemName', 300) && optionalString(data, 'unit', 50) &&
        optionalString(data, 'unitId', 100) && optionalNullableString(data, 'vendorId', 100) &&
        optionalNullableString(data, 'vendorOverride', 100) && optionalNullableString(data, 'overrideVendorId', 100) &&
        optionalString(data, 'notes', 2000) && optionalLegacyDate(data, 'receivedAt') &&
        optionalLegacyDate(data, 'createdAt') && optionalLegacyDate(data, 'updatedAt') &&
        optionalLegacyDate(data, 'lastOrdered') && optionalString(data, 'requesterEmail', 254) &&
        optionalString(data, 'fulfilledByOrderLineId', 100) && optionalString(data, 'neededByDate', 40) &&
        optionalString(data, '﻿requestId', 100) && optionalString(data, 'batchedIntoOrderId', 100) &&
        optionalString(data, 'reason', 1000) && optionalString(data, 'createdBy', 254);
    }

    function isValidPublicRequestCreate(data) {
      return isValidRequest(data) && data.keys().hasOnly([
          'catalogId', 'otherItemName', 'quantity', 'unit', 'notes', 'status',
          'createdAt', 'updatedAt'
        ]) && data.keys().hasAll(['quantity', 'status', 'createdAt', 'updatedAt']) &&
        (('catalogId' in data) != ('otherItemName' in data)) && data.status == 'Open' &&
        data.quantity is number && data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidPublicRequestUpdate(data) {
      let changed = data.diff(resource.data).affectedKeys();
      let noteEdit = changed.hasOnly(['notes']) && changed.hasAll(['notes']);
      let quantityEdit = changed.hasOnly(['quantity', 'qty', 'unit', 'notes', 'updatedAt']) &&
        changed.hasAny(['quantity', 'qty']) && changed.hasAll(['updatedAt']) && data.updatedAt == request.time;
      let receiveEdit = changed.hasOnly(['status', 'receivedAt']) &&
        changed.hasAll(['status', 'receivedAt']) && data.status == 'Received' &&
        resource.data.status in ['Open', 'Ordered', 'Backordered', 'Back ordered'] &&
        data.receivedAt == request.time;
      return isValidRequest(data) && (noteEdit || quantityEdit || receiveEdit);
    }

    function isValidInventory(data) {
      return data.keys().hasOnly([
          'catalogId', 'itemId', 'itemName', 'unitId', 'compartment', 'expiryDate',
          'quantity', 'qty', 'status', 'crewStatus', 'createdAt', 'updatedAt',
          'updatedBy', 'lot', 'notes', 'daysToExpire', 'inventoryId'
        ]) && data.keys().hasAll(['unitId', 'status']) &&
        data.unitId is string && data.unitId.size() > 0 && data.unitId.size() <= 100 &&
        (('catalogId' in data && data.catalogId != null) ||
          ('itemId' in data && data.itemId.size() > 0) ||
          ('itemName' in data && data.itemName.size() > 0)) &&
        (('quantity' in data && data.quantity is number && data.quantity >= 0 && data.quantity <= 100000) ||
          ('qty' in data && data.qty is number && data.qty >= 0 && data.qty <= 100000)) &&
        data.status is string && data.status in ['', 'Pending', 'OK', 'Replaced'] &&
        optionalNullableString(data, 'catalogId', 100) && optionalString(data, 'itemId', 100) &&
        optionalString(data, 'itemName', 300) && optionalString(data, 'compartment', 200) &&
        optionalLegacyDate(data, 'expiryDate') && optionalString(data, 'crewStatus', 2000) &&
        optionalLegacyDate(data, 'createdAt') && optionalLegacyDate(data, 'updatedAt') &&
        optionalString(data, 'updatedBy', 254) && optionalString(data, 'lot', 200) &&
        optionalString(data, 'notes', 2000) && optionalNumber(data, 'daysToExpire', -100000, 100000) &&
        optionalString(data, 'inventoryId', 100);
    }

    function isValidPublicInventoryCreate(data) {
      return isValidInventory(data) && data.keys().hasOnly([
          'catalogId', 'itemName', 'unitId', 'compartment', 'expiryDate', 'quantity',
          'status', 'crewStatus', 'createdAt', 'updatedAt'
        ]) && data.keys().hasAll([
          'unitId', 'compartment', 'expiryDate', 'quantity', 'status', 'crewStatus',
          'createdAt', 'updatedAt'
        ]) && (('catalogId' in data) != ('itemName' in data)) &&
        data.expiryDate is timestamp && data.quantity >= 1 && data.status == '' &&
        data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidPublicInventoryUpdate(data) {
      let changed = data.diff(resource.data).affectedKeys();
      let statusEdit = changed.hasOnly(['status', 'updatedAt']) &&
        changed.hasAll(['status', 'updatedAt']) &&
        data.status in ['Pending', 'OK', 'Replaced'] && data.updatedAt == request.time;
      let detailEdit = changed.hasOnly([
          'unitId', 'compartment', 'quantity', 'crewStatus', 'expiryDate', 'updatedAt'
        ]) && changed.hasAll(['updatedAt']) && changed.hasAny([
          'unitId', 'compartment', 'quantity', 'crewStatus', 'expiryDate'
        ]) && data.updatedAt == request.time;
      return isValidInventory(data) && (statusEdit || detailEdit);
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['email']) && data.email is string && data.email.size() <= 254 &&
        data.email == request.auth.token.email && optionalString(data, 'displayName', 200) &&
        optionalString(data, 'photoURL', 2048) && (!('role' in data) || data.role == 'Staff') &&
        optionalTimestamp(data, 'createdAt') && optionalTimestamp(data, 'updatedAt');
    }

    match /catalog/{docId} {
      allow read: if true;
      allow create, update: if isStaff() && isValidCatalog(request.resource.data);
      allow delete: if isStaff();
    }
    match /units/{docId} {
      allow read: if true;
      allow create, update: if isStaff() && isValidUnit(request.resource.data);
      allow delete: if isStaff();
    }
    match /compartments/{docId} {
      allow read: if true;
      allow create, update: if isStaff() && isValidNamedSetting(request.resource.data);
      allow delete: if isStaff();
    }
    match /categories/{docId} {
      allow read: if true;
      allow create, update: if isStaff() && isValidNamedSetting(request.resource.data);
      allow delete: if isStaff();
    }
    match /vendors/{docId} {
      allow read: if true;
      allow create, update: if isStaff() && isValidVendor(request.resource.data);
      allow delete: if isStaff();
    }
    match /vendorPricing/{docId} {
      allow read: if true;
      allow create, update: if isStaff() && isValidVendorPricing(request.resource.data);
      allow delete: if isStaff();
    }
    match /inventory/{docId} {
      allow read: if true;
      allow create: if isValidPublicInventoryCreate(request.resource.data) ||
        (isStaff() && isValidInventory(request.resource.data));
      allow update: if isValidPublicInventoryUpdate(request.resource.data) ||
        (isStaff() && isValidInventory(request.resource.data));
      allow delete: if isStaff();
    }
    match /requests/{docId} {
      allow read: if true;
      allow create: if isValidPublicRequestCreate(request.resource.data) ||
        (isStaff() && isValidRequest(request.resource.data) &&
          validRequestQuantity(request.resource.data));
      allow update: if isValidPublicRequestUpdate(request.resource.data) ||
        (isStaff() && isValidRequest(request.resource.data));
      allow delete: if isStaff();
    }
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && uidUnchanged() && isValidUser(request.resource.data) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'Staff');
      allow update: if isOwner(userId) && uidNotModified() && isValidUser(request.resource.data) &&
        (!('role' in resource.data) || request.resource.data.role == resource.data.role);
      allow delete: if isOwner(userId);
    }
    match /orders/{orderId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
